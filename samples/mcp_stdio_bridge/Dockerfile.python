# stdio MCP server (Python) behind the streamable-HTTP bridge — AgentCore
# Runtime MCP contract: linux/arm64, 0.0.0.0:8000/mcp.
#
# Build context: your server's files + requirements.txt (optional) +
# mcp_stdio_bridge.py from this directory. The stdio command comes from
# MCP_STDIO_COMMAND (JSON array) — set below, or per deploy as runtime env.
FROM --platform=linux/arm64 python:3.13-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    MCP_STDIO_CWD=/app

WORKDIR /app
COPY . .
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi \
    && useradd --create-home --uid 1000 mcp

USER mcp
EXPOSE 8000
# override with your server's command, e.g. ["python", "-m", "my_server"]
ENV MCP_STDIO_COMMAND='["python", "server.py"]'
ENTRYPOINT ["python", "/app/mcp_stdio_bridge.py"]
